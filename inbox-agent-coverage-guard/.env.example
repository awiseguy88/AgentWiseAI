# Inbox Agent Coverage Guard configuration
ICG_PORT=3400
ICG_PROVIDER=mock
ICG_INBOX=default
ICG_PROCESSED_LABEL=PROCESSED
ICG_MOCK_INBOX_FILE=tests/fixtures/gmail-inbox.json

# Webhook token (optional but recommended)
ICG_WEBHOOK_TOKEN=

# Gmail OAuth (for real Gmail accounts)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3400/oauth/callback

# Outlook OAuth (for real Outlook accounts)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3400/oauth/callback