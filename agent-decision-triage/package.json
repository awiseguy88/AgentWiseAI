{
  "name": "agent-decision-triage",
  "version": "0.1.0",
  "private": true,
  "description": "Local inbox and bridge for triaging decisions from parallel coding agents.",
  "homepage": "https://aaronwiseai.com/",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-decision-triage": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx fixtures/agents/run-demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
