# Lemonade local AI server
# Local LAN example: http://192.168.12.174:13305
# Remote/tunneled example: https://<your-tunnel>.trycloudflare.com
LEMONADE_BASE_URL=http://192.168.12.174:13305
# LEMONADE_API_KEY=   # only if your Lemonade server requires auth
LEMONADE_TIMEOUT_MS=60000

# Where generated images + metadata sidecars are stored
OUTPUT_DIR=outputs

# Social platforms allowed to publish (comma-separated), e.g. x,linkedin,mastodon
SOCIAL_ENABLED_PLATFORMS=
# Default to dry-run so nothing posts accidentally
SOCIAL_DRY_RUN_DEFAULT=true

# MCP transport (stdio recommended for local MCP clients)
MCP_TRANSPORT=stdio
