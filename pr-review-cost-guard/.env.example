# PR Review Cost Guard configuration (example)
# Copy to .env and adjust. All values are local estimates — no network is used.

# Cheap first-pass model (scans every hunk, near-zero cost)
CHEAP_MODEL=claude-haiku-4.5
CHEAP_INPUT_PRICE_PER_1K=0.25

# Pricier reviewer model (only flagged hunks are sent here)
PRICIER_MODEL=claude-sonnet-4.5
PRICIER_INPUT_PRICE_PER_1K=3.00
PRICIER_OUTPUT_PRICE_PER_1K=15.00
PRICIER_OUTPUT_TOKENS=400

# Token estimation
TOKENS_PER_LINE=0.75
LARGE_HUNK_LINES=60

# Monthly spend cap (USD). Runs projected over the remaining budget are blocked.
MONTHLY_CAP_USD=50
