{
  "name": "agent-output-quality-sentinel",
  "version": "0.1.0",
  "description": "Local-first agent output quality scorer: verbosity, redundancy, step repetition, claim density, code yield, SQLite persistence, HTML/JSON reports, and a CI gate.",
  "homepage": "https://aaronwiseai.com/",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test",
    "smoke": "node src/cli.js --input fixtures/slop-transcript.jsonl --out reports/smoke --json --html --gate 60",
    "gate:clean": "node src/cli.js --input fixtures/good-transcript.jsonl --gate 60",
    "gate:slop": "node src/cli.js --input fixtures/slop-transcript.jsonl --gate 60"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  }
}