{
  "description": "Demo scenario: 3 background jobs showing success, pipefail failure, and secret scrubbing",
  "jobs": [
    {
      "name": "build-success",
      "command": "echo 'Build complete' && echo 'All tests passed'",
      "pipefail": false
    },
    {
      "name": "test-failure-pipefail",
      "command": "echo 'FAIL: test_broken' && exit 1 | cat",
      "pipefail": true
    },
    {
      "name": "secret-scrubbing",
      "command": "echo 'API_KEY=sk-abcdefghijklmnopqrstuvwxyz123456' && echo 'token=ghp_abcdefghijklmnopqrstuvwxyz0123456789'",
      "pipefail": false
    }
  ]
}
